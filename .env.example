# ---------------------------------------------------------------------------
# DocSage configuration template. Copy to `.env` and fill in your own values.
# NEVER commit the real `.env` file (it is gitignored).
# ---------------------------------------------------------------------------

# --- Model provider --------------------------------------------------------
# Pick ONE provider and set its key. The other can stay empty.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- LangSmith (tracing + evaluation) ---------------------------------------
# Set LANGCHAIN_TRACING_V2=true to auto-trace all LangChain/LangGraph runs.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=docsage
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- LangFuse (observability: traces, spans, scores) ------------------------
# Cloud: https://cloud.langfuse.com   (or point LANGFUSE_HOST at a self-hosted instance)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App behaviour ----------------------------------------------------------
# Max query-rewrite attempts inside the LangGraph agent before giving up.
DOCSAGE_MAX_RETRIES=2
# Local path for the seedable vector store (InMemoryVectorStore snapshot).
DOCSAGE_VECTOR_STORE_PATH=.data/vectorstore
# Directory of .md/.txt documents used for retrieval ("docsage seed" creates it).
DOCSAGE_CORPUS_DIR=corpus
# Number of documents retrieved per query.
DOCSAGE_TOP_K=4
